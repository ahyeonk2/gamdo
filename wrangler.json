{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "gamdo-garden",
  "main": "src/worker.mjs",
  "compatibility_date": "2026-05-15",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": true
  },
  "observability": {
    "enabled": true
  },
  "vars": {
    "TABLET_ORIGIN": "https://replace-tablet-origin.example"
  }
}
